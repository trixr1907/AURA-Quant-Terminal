# ==============================================================================
# AURA v3 — Beispiel-Umgebungskonfiguration (.env.example)
# ==============================================================================
# Kopiere diese Datei nach .env und passe die Werte fuer dein System an.
# SICHERHEITSHINWEIS: Fuehre niemals echte Passwoerter oder Tokens in Git ein!

# 1. Netzwerk & Host-Binding
# Im privaten LAN oder Tailscale/WireGuard: z.B. 127.0.0.1 oder private VM-IP 192.168.8.115
AURA_HOST=127.0.0.1
AURA_PORT=8000

# 2. Authentifizierung (ADR-0004)
# Generiere einen sicheren 32-Byte Hex-Token mit: python3 -c "import secrets; print(secrets.token_hex(32))"
AURA_RELAY_TOKEN=change_me_to_a_secure_random_token_in_production

# 3. Benachrichtigungen (ntfy)
# Deine private ntfy Topic-URL (z.B. https://ntfy.sh/aura_alerts_mysecret123)
AURA_NTFY_URL=https://ntfy.sh/aura_alerts_demo

# 4. Persistenz
AURA_DB_PATH=/data/aura_state.db
