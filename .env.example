# ==========================================================
# AURA Quant Terminal - Environment Variablen
# ==========================================================

# Port-Binding fuer die Proxmox VM:
# 0.0.0.0 bindet den Service an alle Netzwerkschnittstellen der VM,
# sodass das Terminal ueber das LAN (z.B. vom Smartphone) erreichbar ist.
AURA_PORT_BIND=0.0.0.0:8000

# Sicherheitstoken (unbedingt aendern!):
AURA_RELAY_TOKEN=aura_secret_token_change_me

# Hostnamen/IPs (erlaubte Origins fuer die API):
AURA_ALLOWED_HOSTS=*

# Aktualisierungsintervall des Workers (in Sekunden):
AURA_WORKER_INTERVAL=60

# Optional: Push-Benachrichtigungen
# AURA_NTFY_URL=https://ntfy.sh/mein_secret_aura_kanal
