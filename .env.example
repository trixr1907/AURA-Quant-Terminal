# AURA Quant Terminal Docker Environment
# Ändere den Port hier, falls 8787 belegt ist:
AURA_PORT=8787

# Kommagetrennte Hostnamen/IPs, unter denen das Dashboard geöffnet wird.
# Beispiel für eine lokale Docker-VM:
AURA_ALLOWED_HOSTS=192.168.8.115

# Optionale ntfy-Topic-URL. Leer bedeutet: alle Relay-Pushes aus.
# Den echten Topic-Namen ausschließlich lokal eintragen, nie committen.
# AURA_NTFY_URL bleibt absichtlich ungesetzt.

# 24/7 BTC-Regime-Wächter: BULL/BEAR/SIDEWAYS, Prio 4.
AURA_NTFY_BTC=1
AURA_NTFY_BTC_COOLDOWN_MIN=30

# Täglicher stiller Digest. Stunde ist UTC (0-23).
AURA_NTFY_DIGEST=1
AURA_NTFY_DIGEST_UTC=7

# Marktdaten-Ausfall >5 Minuten, Prio 4, 60-Minuten-Cooldown.
AURA_NTFY_ERRORS=1
